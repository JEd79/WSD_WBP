  FILE: driver.py  (write EXACTLY this)
  --------------------------------------------------------------------------------
  import os, re
  import requests
  from pyspark.sql import SparkSession
  from delta import configure_spark_with_delta_pip
  from file_processing import process_file
  from table_writing import write_table, TableWriteOptions

  BASE = os.path.dirname(os.path.abspath(__file__))
  API = os.environ.get("CONFIG_API", "http://localhost:8080")

  def fetch_configs():
      """Read configuration from the LIVE web service over HTTP."""
      reads = requests.get(f"{API}/api/v1/read-configs", timeout=30).json()
      writes_list = requests.get(f"{API}/api/v1/write-configs", timeout=30).json()
      writes = {w["id"]: w for w in writes_list}
      print(f"Fetched {len(reads)} read config(s) and {len(writes)} write config(s) from {API}")
      return reads, writes

  def make_spark():
      builder = (SparkSession.builder.appName("sifft-e2e-poc").master("local[1]")
          .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension")
          .config("spark.sql.catalog.spark_catalog",
                  "org.apache.spark.sql.delta.catalog.DeltaCatalog")
          .config("spark.ui.enabled", "false")
          .config("spark.sql.shuffle.partitions", "1"))
      spark = configure_spark_with_delta_pip(builder).getOrCreate()
      spark.sparkContext.setLogLevel("ERROR")
      return spark

  def main():
      reads, writes = fetch_configs()
      spark = make_spark()
      landing = os.path.join(BASE, "landing")
      files = [os.path.join(landing, f) for f in os.listdir(landing)]
      written = []
      for rc in reads:
          wc = writes.get(rc.get("writeConfigId"))
          if not wc:
              print("SKIP read id", rc.get("id"), "- no linked write config"); continue
          # 1) match a landing file against the config's regex pattern
          matched = [p for p in files if re.fullmatch(rc["pattern"], os.path.basename(p))]
          if not matched:
              print("UNMATCHED pattern:", rc["pattern"]); continue
          path = matched[0]
          # 2) READ via SIFFT using the read config
          header = rc["header"] if rc.get("header") in ("true", "false") else "true"
          res = process_file(path, spark,
                             read_options={"delimiter": rc["delimiter"], "header": header})
          print("PROCESS", os.path.basename(path), "-> table", wc["targetTable"],
                "success=", res.success, "rows=", res.rows_processed)
          if not res.success or res.rows_processed == 0:
              continue
          # 3) apply column names from config
          df = res.dataframe.toDF(*rc["columns"])
          # 4) WRITE via SIFFT using the write config (path-based Delta table)
          out = os.path.join(BASE, "output", wc["targetTable"]).replace("\\", "/")
          opts = TableWriteOptions(format=wc["format"], mode=wc["mode"],
                                   schema_mode=wc["schemaMode"], add_source_metadata=True)
          wr = write_table(df, f"delta.`{out}`", spark, opts, source_file_path=path)
          print("WRITE", wc["targetTable"], "mode=", wc["mode"],
                "success=", wr.success, "rows_written=", wr.rows_written)
          if not wr.success:
              print("WRITE error:", wr.error); continue
          written.append((wc["targetTable"], out))
      # 5) read each written Delta table back to prove it exists
      print("\n--- READBACK (final table contents) ---")
      for name, out in dict(written).items():  # de-dup table names; show final state
          back = spark.read.format("delta").load(out)
          print(f"TABLE {name}: count=", back.count())
          back.show(truncate=False)
      spark.stop()
      print("E2E_PoC_DONE" if written else "E2E_PoC_DONE (no tables written)")

  if __name__ == "__main__":
      main()
