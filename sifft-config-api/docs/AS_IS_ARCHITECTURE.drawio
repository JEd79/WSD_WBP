<mxfile host="app.diagrams.net" type="device">
  <diagram name="SIFFT AS-IS" id="sifft-as-is">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="SIFFT AS-IS — configuration lives inside each notebook" style="text;html=1;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="440" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="sifft" value="SIFFT library&#10;(installed on all clusters)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="70" width="170" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="data1" value="Inbound DATA&#10;(SFTP → Volume)" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="data2" value="Inbound DATA&#10;(SFTP → Volume)" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="640" y="180" width="150" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="nb1" value="Databricks notebook 1&#10;Pull → Ingest → Cleanup&#10;(config baked in: FILE_MAPPINGS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7e9;strokeColor=#b71c2b;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="120" y="280" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="nb1lib" value="imports SIFFT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="340" width="100" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="nb2" value="Databricks notebook 2&#10;Pull → Ingest → Cleanup&#10;(config baked in: FILE_MAPPINGS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde7e9;strokeColor=#b71c2b;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="nb2lib" value="imports SIFFT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6368;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="340" width="100" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="more" value="… more notebooks (40+ file mappings total)" style="text;html=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="190" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="store" value="Data store (D)&#10;Delta tables / Unity Catalog" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f1f3f4;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="350" y="460" width="150" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="To change a delimiter, add a file type, or change a target table&#10;you must EDIT CODE and REDEPLOY the notebook." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="580" width="290" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="es1" value="imports" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="sifft" target="nb1lib">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="es2" value="imports" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="sifft" target="nb2lib">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed1" value="files" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="data1" target="nb1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed2" value="files" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="data2" target="nb2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ew1" value="validated ingest" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="nb1" target="store">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ew2" value="validated ingest" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="nb2" target="store">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
