<mxfile host="app.diagrams.net" type="device">
  <diagram name="End-to-End Sequence" id="e2e-seq">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="End-to-end: config change flows through to data in the store" style="text;html=1;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="520" height="30" as="geometry"/>
        </mxCell>

        <!-- Lifelines (heads) -->
        <mxCell id="hUser" value="Data Platform&#10;user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hWS" value="Config Web Service&#10;(Spring Boot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="50" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hCfg" value="Config store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;" vertex="1" parent="1">
          <mxGeometry x="430" y="50" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hNB" value="Databricks&#10;notebook/job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="620" y="50" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hSIFFT" value="SIFFT library" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="820" y="50" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hD" value="Data store (D)&#10;Delta" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f1f3f4;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="1000" y="45" width="80" height="55" as="geometry"/>
        </mxCell>

        <!-- Lifelines (dashed) -->
        <mxCell id="lUser" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="90" as="sourcePoint"/><mxPoint x="100" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lWS" style="endArrow=none;dashed=1;html=1;strokeColor=#1a73e8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="90" as="sourcePoint"/><mxPoint x="290" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lCfg" style="endArrow=none;dashed=1;html=1;strokeColor=#1a73e8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="90" as="sourcePoint"/><mxPoint x="490" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lNB" style="endArrow=none;dashed=1;html=1;strokeColor=#5f6368;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="90" as="sourcePoint"/><mxPoint x="685" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lSIFFT" style="endArrow=none;dashed=1;html=1;strokeColor=#5f6368;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="90" as="sourcePoint"/><mxPoint x="880" y="760" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lD" style="endArrow=none;dashed=1;html=1;strokeColor=#5f6368;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="100" as="sourcePoint"/><mxPoint x="1040" y="760" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Phase 1 label -->
        <mxCell id="ph1" value="On demand: user updates configuration" style="text;html=1;fontStyle=2;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="400" height="20" as="geometry"/></mxCell>

        <!-- 1 POST -->
        <mxCell id="m1" value="1. POST /api/v1/read-configs (JSON)" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="150" as="sourcePoint"/><mxPoint x="290" y="150" as="targetPoint"/></mxGeometry></mxCell>
        <!-- 2 validate self -->
        <mxCell id="m2" value="2. validate" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="180" as="sourcePoint"/><mxPoint x="360" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2b" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="195" as="sourcePoint"/><mxPoint x="290" y="195" as="targetPoint"/></mxGeometry></mxCell>
        <!-- 3 save -->
        <mxCell id="m3" value="3. save validated config (if valid)" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="225" as="sourcePoint"/><mxPoint x="490" y="225" as="targetPoint"/></mxGeometry></mxCell>
        <!-- 201 back -->
        <mxCell id="m3b" value="201 Created (or 400/422 if invalid)" style="html=1;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="255" as="sourcePoint"/><mxPoint x="100" y="255" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Phase 2 label -->
        <mxCell id="ph2" value="Later: scheduled run (e.g. daily 10:30)" style="text;html=1;fontStyle=2;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="400" height="20" as="geometry"/></mxCell>
        <mxCell id="sep" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="330" as="sourcePoint"/><mxPoint x="1080" y="330" as="targetPoint"/></mxGeometry></mxCell>

        <!-- 4 read config -->
        <mxCell id="m4" value="4. read current config" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="360" as="sourcePoint"/><mxPoint x="490" y="360" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4b" value="config" style="html=1;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="390" as="sourcePoint"/><mxPoint x="685" y="390" as="targetPoint"/></mxGeometry></mxCell>
        <!-- 5 process -->
        <mxCell id="m5" value="5. process_file(...) using config" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="430" as="sourcePoint"/><mxPoint x="880" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5b" value="DataFrame + result" style="html=1;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="460" as="sourcePoint"/><mxPoint x="685" y="460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5c" value="validate + write_table(... target table ...)" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="495" as="sourcePoint"/><mxPoint x="880" y="495" as="targetPoint"/></mxGeometry></mxCell>
        <!-- 6 write data -->
        <mxCell id="m6" value="6. write validated data" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="525" as="sourcePoint"/><mxPoint x="1040" y="525" as="targetPoint"/></mxGeometry></mxCell>
        <!-- confirm -->
        <mxCell id="m7" value="confirm processed (tracking)" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="685" y="560" as="sourcePoint"/><mxPoint x="490" y="560" as="targetPoint"/></mxGeometry></mxCell>

        <!-- scope note -->
        <mxCell id="note" value="PoC builds steps 1–3 (web service).  Steps 5–6 are existing SIFFT.  Step 4 (notebook reads store instead of hard-coded config) is the small integration not built in the PoC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="120" y="620" width="840" height="60" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
